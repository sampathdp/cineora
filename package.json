{
  "name": "cineora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"next dev\" \"npm run dev:api\"",
    "dev:web": "next dev",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:api:artisan": "cd backend && php artisan serve --port=8000",
    "build": "next build",
    "start": "node scripts/serve-static.mjs out",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "images:webp": "node scripts/to-webp.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "framer-motion": "^14.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
