APP_NAME="AR Entertainment"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cineora
DB_USERNAME=cineora
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use "resend" to send real email via Resend (https://resend.com); "log" writes mail to storage/logs.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# From address must be on a domain verified in Resend (or onboarding@resend.dev for testing).
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AR Entertainment ---
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
# Production example: SESSION_DOMAIN=.example.com, SESSION_SECURE_COOKIE=true, SESSION_SAME_SITE=lax
SESSION_SAME_SITE=lax
CINEORA_CURRENCY=KRW
CINEORA_TIMEZONE=Asia/Seoul
BOOKING_SEAT_HOLD_MINUTES=120
BOOKING_PAYMENT_DEADLINE_MINUTES=120
BOOKING_MAX_SEATS=8
BOOKING_MAX_UNPAID=1
BOOKING_SERVICE_FEE_PER_SEAT=0

# Phase 8/9
PROOF_RATE_LIMIT=5
REFUND_CUTOFF_HOURS=48
TICKET_CHECKIN_OPENS_MINUTES=120
CONTACT_RATE_LIMIT=5
